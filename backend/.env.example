APP_NAME=Vidyalaya OS
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,192.168.1.3"
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
PLATFORM_DOMAIN=localhost
WEB_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Must be a normal role: NOT a superuser and without BYPASSRLS.
POSTGRES_DB=sms
POSTGRES_USER=sms_app
POSTGRES_PASSWORD=sms_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Public demo (DEPLOY.md): turns on the two settings below and shows demo parent codes on screen.
DEMO_MODE=true
# Demo data: fill an empty database on `migrate`, and show demo logins on the sign-in page.
DEMO_AUTOLOAD=true
DEMO_LOGINS_VISIBLE=true
# Real email. Leave BREVO_API_KEY empty to print emails to the console instead.
# The DEFAULT_FROM_EMAIL address must be a verified sender in Brevo.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Vidyalaya OS <no-reply@localhost>
# Online fee payments by parents. A gateway is on once its keys are set.
# Razorpay test keys (rzp_test_...) and JUSPAY_ENV=sandbox take no real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
JUSPAY_ENV=sandbox
JUSPAY_MERCHANT_ID=
JUSPAY_API_KEY=
JUSPAY_PAYMENT_PAGE_CLIENT_ID=
JUSPAY_WEBHOOK_USERNAME=
JUSPAY_WEBHOOK_PASSWORD=
# In development (DJANGO_DEBUG=true) a built-in test gateway is offered too.
PAYMENT_SIMULATOR=true
